# Paikallinen kehitys — kopioi .env.local:ksi

# Supabase (löytyy: supabase status, tai Dashboard → Settings → API)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJ...

# VAPID (generoi: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=B...

# Google OAuth Client ID (Google Cloud Console → Credentials)
# Authorized JavaScript origins: http://localhost:5173
# Authorized redirect URIs: http://localhost:5173/connect-google/callback
VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
