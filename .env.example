# Kopioi tämä .env.local-tiedostoksi ja täytä oikeat arvot
# Löydät arvot Supabasen dashboardista: Settings → API

VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# VAPID-avain — generoi: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=B...

# Google OAuth Client ID (Authorized JavaScript Origins -kohtaan lisätään localhost:5173 ja production-URL)
VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
